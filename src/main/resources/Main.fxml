<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.controller.MainController">
    <padding>
        <Insets top="15.0" right="15.0" bottom="15.0" left="15.0" />
    </padding>

    <Label text="Графічна консоль управління студентами (Колекції та Map)" style="-fx-font-weight: bold; -fx-font-size: 15px;" />
    <Separator />

    <HBox spacing="20.0">
        <VBox spacing="8.0" prefWidth="350.0">
            <Label text="Введення даних (Додавання):" style="-fx-font-weight: bold;" />
            <GridPane hgap="8.0" vgap="5.0">
                <Label text="ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtNewId" promptText="Число" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="ПІБ:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="txtNewName" promptText="Прізвище І.О." GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Дата:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <TextField fx:id="txtNewDate" promptText="РРРР-ММ-ДД" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Факультет:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <TextField fx:id="txtNewFaculty" promptText="КН" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label text="Група:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                <TextField fx:id="txtNewGroup" promptText="КН-31" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                <Label text="Рейтинг:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                <TextField fx:id="txtNewRating" promptText="95.5" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                <Label text="Фінансування:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                <TextField fx:id="txtNewFunding" promptText="бюджет" GridPane.columnIndex="1" GridPane.rowIndex="6" />
            </GridPane>

            <Button text="Додати студента до списку" onAction="#handleAddStudent" prefWidth="350.0" />
            <Separator />

            <Label text="Вилучення та перегляд:" style="-fx-font-weight: bold;" />
            <HBox spacing="10.0">
                <Button text="Показати всіх" onAction="#handleShowAll" prefWidth="170.0" />
                <TextField fx:id="txtDeleteId" promptText="ID для видалення" prefWidth="170.0" />
            </HBox>
            <Button text="Вилучити знайденого студента" onAction="#handleRemoveStudent" prefWidth="350.0" style="-fx-text-fill: #d32f2f;" />
            <Separator />

            <Label text="Робота з файлами (TXT / BIN):" style="-fx-font-weight: bold;" />
            <GridPane hgap="5.0" vgap="5.0">
                <Button text="Зберегти TXT" onAction="#handleSaveTxt" prefWidth="170.0" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <Button text="Читати TXT" onAction="#handleLoadTxt" prefWidth="170.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Button text="Зберегти BIN" onAction="#handleSaveBin" prefWidth="170.0" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <Button text="Читати BIN" onAction="#handleLoadBin" prefWidth="170.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            </GridPane>
        </VBox>

        <VBox spacing="10.0" prefWidth="420.0">
            <Label text="Панель виконання запитів 1-7:" style="-fx-font-weight: bold;" />

            <HBox spacing="10.0">
                <TextField fx:id="txtFaculty" promptText="Введіть факультет" prefWidth="150.0" />
                <Button text="Запит 1: Фільтр за факультетом" onAction="#handleFilterFaculty" prefWidth="250.0" />
            </HBox>

            <HBox spacing="10.0">
                <TextField fx:id="txtYear" promptText="Введіть рік" prefWidth="150.0" />
                <Button text="Запит 2: Народились після року" onAction="#handleFilterYear" prefWidth="250.0" />
            </HBox>

            <HBox spacing="10.0">
                <TextField fx:id="txtGroup" promptText="Введіть групу" prefWidth="150.0" />
                <Button text="Запит 3: Студенти групи" onAction="#handleFilterGroup" prefWidth="250.0" />
            </HBox>

            <HBox spacing="10.0">
                <Label text="Кошти юр.осіб:" prefWidth="150.0" />
                <Button text="Запит 4: Студенти (юр.особа)" onAction="#handleLegalFunding" prefWidth="250.0" />
            </HBox>

            <HBox spacing="10.0">
                <TextField fx:id="txtId" promptText="Введіть ID" prefWidth="150.0" />
                <Button text="Запит 5: Пошук інформації за ID" onAction="#handleFindById" prefWidth="250.0" />
            </HBox>

            <HBox spacing="10.0">
                <Label text="Мапінг факультетів:" prefWidth="150.0" />
                <Button text="Запит 6: Сгрупувати за факультетами (Map)" onAction="#handleGroupByFaculty" prefWidth="250.0" />
            </HBox>

            <HBox spacing="10.0">
                <Label text="Демографія:" prefWidth="150.0" />
                <Button text="Запит 7: Кількість за роками (Map)" onAction="#handleCountByYear" prefWidth="250.0" />
            </HBox>

            <Separator />
            <Label text="Результат виведення:" style="-fx-font-weight: bold;" />
            <TextArea fx:id="txtAreaOutput" prefHeight="230.0" prefWidth="420.0" editable="false" style="-fx-font-family: 'Courier New';" />
        </VBox>
    </HBox>
</VBox>